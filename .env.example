# 复制为仓库根目录的 .env 后按需修改：
#   cp .env.example .env
#
# 宿主机在局域网中的地址（生成样式时要填进 --tile-base / --public-base）
HOST=192.0.2.10

# 时区（容器环境变量）
TZ=Asia/Shanghai

# 持久化目录：tile-proxy 的管理配置
DATA_DIR=./data

# 样式输出目录（immich_amap static 的 --out 目标）
STYLE_DIR=./dist/mapstyles

# nginx 配置（仓库自带，一般不用改）
NGINX_CONF=./deploy/nginx/style-server.conf

# 宿主机端口
TILE_PROXY_PORT=9002
MAPSTYLE_PORT=9003
